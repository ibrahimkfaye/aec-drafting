# Copy to .env.local and fill in. NEVER commit .env.local.
# Values marked SERVER-ONLY must never be prefixed with NEXT_PUBLIC_.

# --- Supabase (Phase 1; values come from `npx supabase status` locally) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER-ONLY. Bypasses row-level security. Used only by seed/admin scripts.
SUPABASE_SECRET_KEY=

# --- Database tests (local only; tests refuse non-localhost hosts) ---
TEST_DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
TEST_DATABASE_NAME=aec_test

# --- Background jobs ---
# local   = runs inside `npm run dev` (DEVELOPMENT ONLY; refused on Vercel)
# trigger = Trigger.dev (required on Vercel preview/production)
JOB_RUNNER=local
# TRIGGER_SECRET_KEY=              # SERVER-ONLY; Vercel gets a "trigger only" key
# TRIGGER_PROJECT_REF=             # from the Trigger.dev dashboard (not created yet)

# --- Worker-only (set in Trigger.dev, NEVER in Vercel) ---
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=             # the app refuses to start jobs on Vercel if this is set there

# --- Later phases: leave blank. Live providers stay OFF until deliberately configured. ---
# AI_PROVIDER_MODE=mock            # mock | live
# ANTHROPIC_API_KEY=               # SERVER-ONLY
# EXTRACTION_MODEL_ID=             # unverified — confirm against provider docs before setting
# DRAFTING_MODEL_ID=
# REVIEW_MODEL_ID=
# AZURE_DOCINTEL_ENDPOINT=
# AZURE_DOCINTEL_KEY=              # SERVER-ONLY
# TRIGGER_SECRET_KEY=              # SERVER-ONLY
# GOTENBERG_URL=                  # private container; worker-only
# GOTENBERG_BASIC_AUTH_USERNAME=  # worker-only
# GOTENBERG_BASIC_AUTH_PASSWORD=  # worker-only
